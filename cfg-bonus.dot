digraph BonusCFG {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", labelloc=t, label="bonus(attendance, threshold) — Control Flow Graph", fontsize=18, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#334155", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
  edge [color="#475569", fontname="DejaVu Sans", fontsize=8, arrowsize=0.7];
  entry [shape=oval, label="Entry", fillcolor="#dcfce7"];
  guard [label="31–32: attendance == null OR threshold < 0 ?"];
  error [label="32: throw IllegalArgumentException", fillcolor="#fee2e2"];
  init [label="35–37: present=0; streak=0; best=0"];
  loop [shape=diamond, label="38: next attendance element?\nattendance p-use"];
  assign [label="38: a = next element\na def"];
  pos [shape=diamond, label="39: a > 0 ?\na p-use"];
  update [label="40–41: present++; streak++"];
  better [shape=diamond, label="42: streak > best ?"];
  best [label="43: best = streak"];
  reset [label="46: streak = 0\n(kills previous streak def)"];
  score0 [label="49: score = 0"];
  threshold [shape=diamond, label="50: present >= threshold ?"];
  score5 [label="51: score = 5"];
  best5 [shape=diamond, label="53: best >= 5 ?"];
  add3 [label="54: score = score + 3"];
  ret [label="56: return score", fillcolor="#dcfce7"];
  entry -> guard [label="All test methods enter the validation guard"];
  guard -> error [label="T: invalidNullAttendanceTakesGuardTrue / invalidNegativeThresholdTakesGuardTrue"];
  guard -> init [label="F: emptyAttendanceCoversZeroIterationsAndThresholdTrue / longStreakCoversBestUpdateAndAdditionalScore"];
  init -> loop [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / emptyAttendanceCoversZeroIterationsAndThresholdTrue / allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart / longStreakCoversBestUpdateAndAdditionalScore / shortStreakCoversBestFalseAndBaseScoreOnly"];
  loop -> assign [label="T: allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart / longStreakCoversBestUpdateAndAdditionalScore"];
  assign -> pos [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart / longStreakCoversBestUpdateAndAdditionalScore / shortStreakCoversBestFalseAndBaseScoreOnly"];
  pos -> update [label="T: mixedAttendanceCoversStreakKillAndRestart / longStreakCoversBestUpdateAndAdditionalScore"];
  pos -> reset [label="F: allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart"];
  update -> better;
  better -> best [label="T: longStreakCoversBestUpdateAndAdditionalScore"];
  better -> loop [label="F: shortStreakCoversBestFalseAndBaseScoreOnly"];
  best -> loop [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / longStreakCoversBestUpdateAndAdditionalScore"];
  reset -> loop [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart"];
  loop -> score0 [label="F: emptyAttendanceCoversZeroIterationsAndThresholdTrue / allAbsentCoversElseResetAndNoBonus"];
  score0 -> threshold [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / emptyAttendanceCoversZeroIterationsAndThresholdTrue / allAbsentCoversElseResetAndNoBonus / mixedAttendanceCoversStreakKillAndRestart / longStreakCoversBestUpdateAndAdditionalScore / shortStreakCoversBestFalseAndBaseScoreOnly"];
  threshold -> score5 [label="T: allDefs_baseScoreDefinitionReachesBonusAddition / shortStreakCoversBestFalseAndBaseScoreOnly"];
  threshold -> best5 [label="F: allDefs_initialScoreDefinitionReachesBonusAddition"];
  score5 -> best5 [label="allDefs_baseScoreDefinitionReachesBonusAddition / emptyAttendanceCoversZeroIterationsAndThresholdTrue / mixedAttendanceCoversStreakKillAndRestart / shortStreakCoversBestFalseAndBaseScoreOnly"];
  best5 -> add3 [label="T: allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition"];
  best5 -> ret [label="F: allAbsentCoversElseResetAndNoBonus / shortStreakCoversBestFalseAndBaseScoreOnly"];
  add3 -> ret [label="allDefs_initialScoreDefinitionReachesBonusAddition / allDefs_baseScoreDefinitionReachesBonusAddition / longStreakCoversBestUpdateAndAdditionalScore"];
}